# build output
dist/
.vercel/
.output/

# dependencies
node_modules/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# environment variables
.env*
!.env.example

# macOS
.DS_Store

# editors
.vscode/*
!.vscode/extensions.json
.idea/

# astro
.astro/

# Asset Ordner / Grossdateien (nicht versionieren)
web/
web-2/
web-2.zip
Dolomites Last Loop Avatar/
Gregor Fotos DLL/
Sport OK Daten/
graphify-out/
Ergebnisliste Dolomites Last Loop 2026.pdf

# Rohvideos (Quellmaterial bleibt lokal). DolomitlastloopQuerformat.mp4 ist
# 120 MB — GitHub lehnt Dateien >100 MB hart ab, und das Repo ist oeffentlich.
*.mp4
*.mov
*.m4v
# Ausnahme: fuer den Hero komprimierte Web-Assets sollen versioniert werden.
# Ohne diese Zeilen wuerde ein spaeteres public/videos/hero-loop.mp4 STILL
# ignoriert (siehe Lektion .env.example, Commit 489f46e). Die Ausnahme muss
# auf Datei-Ebene stehen — ein blosses "!public/videos/" wuerde NICHT greifen,
# weil "*.mp4" die Datei selbst matcht und die letzte passende Regel gewinnt.
!public/videos/*.mp4
!public/videos/*.webm

# Operative Exportlisten (Teilnehmerdaten, Zahlungslinks). Entstehen z. B. beim
# Wartelisten-Versand am 01.09.2026: eine TSV mit 23 Zeilen aus E-Mail, Name und
# funktionierendem Stripe-Checkout-Link. Das Repo ist OEFFENTLICH — ein
# unbedachtes "git add ." wuerde solche Links weltweit lesbar machen.
# Geprueft vor dem Setzen der Wildcard: es ist keine .tsv getrackt
# (git ls-files | grep '\.tsv$' = leer), die Regel verdeckt also nichts
# Bestehendes — vgl. die .env.example-Lektion in Commit 489f46e.
*.tsv


# Agentic OS Template - Downstream Ignore Defaults

# Runtime State (work logs are session-local; private is never committed)
.agentcortex/context/work/*.md
.agentcortex/context/work/*.lock.json
!.agentcortex/context/work/.gitkeep.md
.agentcortex/context/.guard_receipt.json
.agentcortex/context/.guard_locks/
.agentcortex/context/private/
.agent/private/

# Deploy Artifacts
.agentcortex-src/
*.acx-incoming
*.acx-local

# Third-party AI Tool Local State
.openrouter/
.claude-chat/
.cursor/
.antigravity/scratch/

# End Agentic OS Template - Downstream Ignore Defaults

