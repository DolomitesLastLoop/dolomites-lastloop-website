---
// Shop v2 — nur für Community-Run-Angemeldete.
//
// Zugang (serverseitig, bei JEDEM Aufruf):
//   1. ?token=<roh> aus dem Mail-Link → Hash gegen community_run_registrations,
//      Widerruf + Ablauf prüfen. Gültig → Session-Cookie setzen und auf die URL
//      OHNE Token umleiten (Token nicht in Verlauf/Referrer/Screenshots).
//   2. Sonst Session-Cookie (src/lib/shop-session.ts) → ID erneut gegen die DB
//      prüfen, damit ein Widerruf sofort greift.
//   3. Sonst: klare Meldung „Zugang nur über Community-Run-Anmeldung" (403).
//
// Nicht auffindbar: noindex, NICHT in sitemap.xml.ts, kein Nav-/Footer-Link.
// Kein Checkout (Shopify/Printful folgt zum Schluss) — das UI sagt das offen.
import { Image } from "astro:assets";
import BaseLayout from "@layouts/BaseLayout.astro";
import PageHero from "@components/PageHero.astro";
import { photo } from "@lib/photos";
import { localizePath, type Lang } from "@i18n/utils";
import { shopCopy, shopProducts, SIZES } from "@i18n/shop";
import { shopPhoto } from "@lib/shop-images";
import {
  checkAccessById,
  checkAccessByToken,
  type AccessCheck,
} from "@lib/community-run";
import {
  clearShopSession,
  isShopSessionConfigured,
  issueShopSession,
  readShopSession,
} from "@lib/shop-session";

export const prerender = false;
const lang = (Astro.params.lang ?? "de") as Lang;
if (!["de", "it", "en"].includes(lang)) return Astro.redirect("/de", 302);
const c = shopCopy[lang];

// Personalisierte Antwort → nie cachen.
Astro.response.headers.set("Cache-Control", "private, no-store");

let access: AccessCheck = { ok: false, reason: "missing" };
const token = (Astro.url.searchParams.get("token") ?? "").trim();

// Fail-closed: ohne SHOP_SESSION_SECRET kann keine Session gesetzt werden — der
// Token bliebe dauerhaft in der URL (Verlauf, Screenshots, Weitergabe). Dann lieber
// ein klarer Serverfehler, noch VOR jeder DB-Abfrage.
const misconfigured = Boolean(token) && !isShopSessionConfigured();
if (misconfigured) {
  console.error("[shop] SHOP_SESSION_SECRET fehlt/zu kurz — Mail-Link-Zugang abgebrochen (500).");
}

if (!misconfigured) try {
  if (token) {
    access = await checkAccessByToken(token);
    if (access.ok && issueShopSession(Astro.cookies, access.id, access.expiresAt)) {
      // Astro.redirect() baut eine neue Response — der oben gesetzte Cache-Control
      // geht dabei verloren. Die Weiterleitung trägt das Session-Cookie → nie cachen.
      const redirect = Astro.redirect(localizePath("/shop", lang), 303);
      redirect.headers.set("Cache-Control", "private, no-store");
      return redirect;
    }
  } else {
    const sessionId = readShopSession(Astro.cookies);
    if (sessionId) {
      access = await checkAccessById(sessionId);
      if (!access.ok) clearShopSession(Astro.cookies);
    }
  }
} catch (err) {
  console.error("[shop] access check failed:", err instanceof Error ? err.message : err);
  access = { ok: false, reason: "invalid" };
}

if (misconfigured) Astro.response.status = 500;
else if (!access.ok) Astro.response.status = 403;
const showExpired = !access.ok && (access.reason === "expired" || access.reason === "revoked");

// Quellbilder sind 800 px breit — größere Breiten würden nur hochskaliert.
const IMG_WIDTHS = [400, 640, 800];
const IMG_SIZES = "(max-width: 900px) 92vw, 560px";
// Querformat-Nachtfoto (1920×1280): Startbogen + Stirnlampen liegen bei ~40–75 % der
// Bildhöhe; der opake Header verdeckt oben ~85 px → Fokus etwas unterhalb der Mitte.
const HERO_POSITION = "center 60%";
---

<BaseLayout lang={lang} title={c.metaTitle} noindex={true}>
  {
    misconfigured ? (
      <section class="section shop-denied">
        <div class="container-narrow text-center">
          <span class="eyebrow">Dolomites Last Loop</span>
          <h1 class="section-title">{c.misconfigured.title}</h1>
          <p class="section-lead">{c.misconfigured.text}</p>
        </div>
      </section>
    ) : !access.ok ? (
      <section class="section shop-denied">
        <div class="container-narrow text-center">
          <span class="eyebrow">Dolomites Last Loop</span>
          <h1 class="section-title">{c.denied.title}</h1>
          <p class="section-lead">{c.denied.text}</p>
          {showExpired && <div class="alert alert-info mt-5">{c.denied.expired}</div>}
          <a href={localizePath("/community-run", lang)} class="btn btn-primary btn-arrow mt-6">
            {c.denied.cta}
          </a>
        </div>
      </section>
    ) : (
      <>
        <PageHero
          bg={photo.night_start}
          position={HERO_POSITION}
          eyebrow={c.hero.eyebrow}
          title={c.hero.title}
          subtitle={c.hero.subtitle}
        />

        <section class="section-tight shop-intro">
          <div class="container text-center">
            <p class="section-lead">{c.hero.text}</p>
            <div class="alert alert-info shop-notice mt-5">{c.notice}</div>
          </div>
        </section>

        {shopProducts.map((p, i) => {
          const photos = shopPhoto[p.id];
          // Vorne/Hinten immer; Getragen/Detail nur, wenn es dafür Fotos gibt.
          const sides = [
            { key: "front", label: c.front, img: photos.front },
            { key: "back", label: c.back, img: photos.back },
            { key: "worn", label: c.worn, img: photos.worn },
            { key: "detail", label: c.detail, img: photos.detail },
          ].flatMap((s) => (s.img ? [{ ...s, img: s.img }] : []));
          return (
            <section class:list={["section", "shop-product", { "section-alt": i % 2 === 1 }]} id={p.id}>
              <div class:list={["container", "shop-product-grid", { "is-flipped": i % 2 === 1 }]}>
                <div class="shop-flip" data-flip>
                  <div class="shop-media">
                    {sides.map((side) => (
                      <div class="shop-photo-slot" data-photo={side.key} hidden={side.key !== "front"}>
                        <Image
                          src={side.img}
                          alt={c.photoAlt(p.name, side.label)}
                          widths={IMG_WIDTHS}
                          sizes={IMG_SIZES}
                          format="webp"
                          loading={i === 0 && side.key === "front" ? "eager" : "lazy"}
                          class="shop-photo"
                        />
                      </div>
                    ))}
                  </div>
                  <div class="shop-toggle" role="group" aria-label={c.viewLabel}>
                    {sides.map((side) => (
                      <button
                        type="button"
                        class:list={{ "is-active": side.key === "front" }}
                        data-photo-toggle={side.key}
                        aria-pressed={side.key === "front" ? "true" : "false"}
                      >
                        {side.label}
                      </button>
                    ))}
                  </div>
                </div>

                <div class="shop-details">
                  <span class="eyebrow">{String(i + 1).padStart(2, "0")} / {String(shopProducts.length).padStart(2, "0")}</span>
                  <h2 class="shop-name">{p.name}</h2>
                  <p class="section-lead">{p.tagline[lang]}</p>

                  <dl class="shop-specs">
                    <div>
                      <dt>{c.colorLabel}</dt>
                      <dd>{c.colorValue}</dd>
                    </div>
                    <div>
                      <dt>{c.sizeLabel}</dt>
                      <dd>{SIZES.join(" · ")}</dd>
                    </div>
                    <div>
                      <dt>{c.priceLabel}</dt>
                      <dd>{c.priceValue}</dd>
                    </div>
                  </dl>

                  {/* Bewusst KEIN Button: es gibt noch keinen Checkout. */}
                  <p class="shop-order-status">
                    <span class="badge badge-pending">{c.orderStatus}</span>
                  </p>
                  <p class="text-dim shop-order-hint">{c.orderHint}</p>
                </div>
              </div>
            </section>
          );
        })}
      </>
    )
  }
</BaseLayout>

<script>
  // Vorne/Hinten-Umschalter je Produkt (Muster aus dem Shop-Mockup).
  document.querySelectorAll<HTMLElement>("[data-flip]").forEach((flip) => {
    const slots = flip.querySelectorAll<HTMLElement>("[data-photo]");
    const buttons = flip.querySelectorAll<HTMLButtonElement>("[data-photo-toggle]");
    buttons.forEach((btn) => {
      btn.addEventListener("click", () => {
        const target = btn.dataset.photoToggle;
        slots.forEach((slot) => {
          slot.hidden = slot.dataset.photo !== target;
        });
        buttons.forEach((b) => {
          const active = b === btn;
          b.classList.toggle("is-active", active);
          b.setAttribute("aria-pressed", String(active));
        });
      });
    });
  });
</script>

<style>
  .shop-denied {
    padding-top: calc(var(--nav-height) + var(--space-8));
  }
  .shop-denied h1 {
    font-size: clamp(2.2rem, 5vw, 3.6rem);
  }
  .shop-intro .section-lead,
  .shop-denied .section-lead {
    margin-left: auto;
    margin-right: auto;
  }
  .shop-notice {
    display: inline-block;
    text-align: left;
  }
  .shop-product-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: var(--space-8);
    align-items: center;
  }
  .shop-product-grid.is-flipped .shop-flip {
    order: 2;
  }
  .shop-media {
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-card);
    background: #142337;
    /* Seitenverhältnis der Quellfotos (800×1071) → kein Beschnitt */
    aspect-ratio: 800 / 1071;
  }
  .shop-photo-slot {
    width: 100%;
    height: 100%;
  }
  .shop-photo-slot[hidden] {
    display: none;
  }
  .shop-photo {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .shop-toggle {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    justify-content: center;
    margin-top: var(--space-4);
  }
  .shop-toggle button {
    padding: 0.4rem 1rem;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    background: var(--color-bg);
    color: var(--color-text-muted);
    cursor: pointer;
    transition: background var(--transition), color var(--transition), border-color var(--transition);
  }
  .shop-toggle button.is-active {
    background: var(--color-primary);
    border-color: var(--color-primary);
    color: #ffffff;
  }
  .shop-name {
    font-family: var(--font-display);
    font-size: clamp(2.2rem, 4vw, 3.2rem);
    letter-spacing: 0.03em;
    line-height: 1;
    margin: var(--space-2) 0 var(--space-4);
  }
  .shop-specs {
    display: grid;
    gap: var(--space-3);
    margin: var(--space-6) 0;
  }
  .shop-specs > div {
    display: flex;
    justify-content: space-between;
    border-top: 1px solid var(--color-border);
    padding-top: var(--space-3);
  }
  .shop-specs dt {
    color: var(--color-text-muted);
  }
  .shop-specs dd {
    margin: 0;
    font-weight: 600;
  }
  .shop-order-status {
    margin: 0 0 var(--space-2);
  }
  .shop-order-hint {
    font-size: 0.9rem;
    margin: 0;
  }
  @media (max-width: 900px) {
    .shop-product-grid {
      grid-template-columns: 1fr;
      gap: var(--space-6);
    }
    .shop-product-grid.is-flipped .shop-flip {
      order: 0;
    }
  }
</style>
