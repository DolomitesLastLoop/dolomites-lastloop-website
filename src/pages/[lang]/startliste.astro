---
import BaseLayout from "@layouts/BaseLayout.astro";
import { useTranslations, type Lang } from "@i18n/utils";
import { getPublicClient, type Participant } from "@lib/supabase";
import { WILDCARD_PARTICIPANTS } from "@lib/wildcard";

export const prerender = false;
const lang = (Astro.params.lang ?? "de") as Lang;
if (!["de", "it", "en"].includes(lang)) return Astro.redirect("/de", 302);
const t = useTranslations(lang);

let participants: Participant[] = [];

try {
  // Least Privilege: öffentliche Seite liest mit dem Anon-Key aus der View
  // participants_public (nur unkritische Spalten, bereits auf confirmed/
  // waitlist gefiltert). Alias status→ticket_status, damit der Rendering-Code
  // unverändert bleibt.
  const supabase = getPublicClient();
  const { data } = await supabase
    .from("participants_public")
    .select(
      "id,vorname,nachname,nationalitaet,ticket_status:status,startnummer,created_at",
    )
    .order("startnummer", { ascending: true, nullsFirst: false })
    .order("created_at", { ascending: true });
  participants = (data as Participant[]) ?? [];
} catch {
  participants = [];
}

// Wildcards laufen als eigene Sektion unterhalb der regulären Liste (kuratiert,
// siehe @lib/wildcard) — aus der regulären Liste entfernt, um Doppel-Einträge
// zu vermeiden.
const wildcardIds = new Set(WILDCARD_PARTICIPANTS.map((w) => w.id));
const wildcardOverrides = new Map(
  WILDCARD_PARTICIPANTS.filter((w) => w.nameOverride).map((w) => [w.id, w.nameOverride!]),
);
const wildcardParticipants = participants.filter((p) => wildcardIds.has(p.id));
participants = participants.filter((p) => !wildcardIds.has(p.id));

const statusLabel = (s: string) => {
  if (s === "confirmed") return t("startlist.status.confirmed");
  if (s === "waitlist") return t("startlist.status.waitlist");
  return t("startlist.status.pending");
};
const statusClass = (s: string) => {
  if (s === "confirmed") return "badge-confirmed";
  if (s === "waitlist") return "badge-waitlist";
  return "badge-pending";
};
---

<BaseLayout
  lang={lang}
  title={t("startlist.title")}
  description={t("meta.startlist")}
  breadcrumbs={[
    { name: t("nav.home"), url: `/${lang}` },
    { name: t("startlist.title"), url: `/${lang}/startliste` },
  ]}
>
  <section class="page-head">
    <div class="container">
      <p class="eyebrow">Live</p>
      <h1>{t("startlist.title")}</h1>
      <p class="section-lead">{t("startlist.counter")}</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      {
        wildcardParticipants.length > 0 && (
          <div class="tabs" role="tablist">
            <button
              type="button"
              class="tab is-active"
              role="tab"
              aria-selected="true"
              data-tab="list"
            >
              {t("startlist.title")}
            </button>
            <button
              type="button"
              class="tab"
              role="tab"
              aria-selected="false"
              data-tab="wildcard"
            >
              {t("startlist.wildcard.title")}
            </button>
          </div>
        )
      }

      <div data-panel="list" role="tabpanel">
        <div class="search-wrap mb-5">
          <input
            type="search"
            id="startlist-search"
            placeholder={t("startlist.search")}
            aria-label={t("startlist.search")}
          />
        </div>

        {
          participants.length === 0 ? (
            <p class="text-dim">{t("startlist.empty")}</p>
          ) : (
            <div class="table-wrap">
              <table class="table" id="startlist-table">
                <thead>
                  <tr>
                    <th>{t("startlist.col.name")}</th>
                    <th>{t("startlist.col.nation")}</th>
                    <th>{t("startlist.col.status")}</th>
                  </tr>
                </thead>
                <tbody>
                  {participants.map((p) => (
                    <tr data-name={`${p.vorname} ${p.nachname}`.toLowerCase()}>
                      <td>
                        {p.vorname} {p.nachname}
                      </td>
                      <td>{p.nationalitaet ?? "—"}</td>
                      <td>
                        <span class={`badge ${statusClass(p.ticket_status)}`}>
                          {statusLabel(p.ticket_status)}
                        </span>
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          )
        }
      </div>

      {
        wildcardParticipants.length > 0 && (
          <div class="wildcard-panel" data-panel="wildcard" role="tabpanel" hidden>
            <h2>{t("startlist.wildcard.title")}</h2>
            <div class="table-wrap">
              <table class="table">
                <thead>
                  <tr>
                    <th>{t("startlist.col.name")}</th>
                    <th>{t("startlist.col.nation")}</th>
                  </tr>
                </thead>
                <tbody>
                  {wildcardParticipants.map((p) => (
                    <tr>
                      <td>
                        {wildcardOverrides.get(p.id) ?? `${p.vorname} ${p.nachname}`}
                      </td>
                      <td>{p.nationalitaet ?? "—"}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </div>
        )
      }
    </div>
  </section>
</BaseLayout>

<style>
  .page-head {
    padding: var(--space-9) 0 var(--space-5);
    border-bottom: 1px solid var(--color-border);
  }
  .search-wrap input {
    width: 100%;
    max-width: 420px;
    background: var(--color-bg-alt);
    color: var(--color-text);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    padding: 0.85rem 1rem;
    font-size: 1rem;
  }
  .search-wrap input:focus {
    border-color: var(--color-accent);
    outline: none;
  }
  .table-wrap {
    overflow-x: auto;
  }
  .tabs {
    display: flex;
    gap: var(--space-2);
    margin-bottom: var(--space-5);
    border-bottom: 1px solid var(--color-border);
  }
  .tab {
    padding: 0.65rem 1.1rem;
    font: inherit;
    font-weight: 600;
    color: var(--color-text-muted);
    background: none;
    border: none;
    border-bottom: 2px solid transparent;
    cursor: pointer;
  }
  .tab:hover {
    color: var(--color-text);
  }
  .tab.is-active {
    color: var(--color-text);
    border-bottom-color: var(--color-primary);
  }
  .tab.is-active[data-tab="wildcard"] {
    color: var(--color-wildcard);
    border-bottom-color: var(--color-wildcard);
  }
  .wildcard-panel {
    padding: var(--space-5);
    border: 1px solid rgba(194, 87, 15, 0.3);
    border-left: 3px solid var(--color-wildcard);
    border-radius: var(--radius);
    background: rgba(194, 87, 15, 0.05);
  }
  .wildcard-panel h2 {
    color: var(--color-wildcard);
    margin-bottom: var(--space-4);
  }
</style>

<script>
  const search = document.getElementById("startlist-search") as HTMLInputElement | null;
  search?.addEventListener("input", () => {
    const q = search.value.trim().toLowerCase();
    document
      .querySelectorAll<HTMLTableRowElement>("#startlist-table tbody tr")
      .forEach((row) => {
        const name = row.dataset.name || "";
        row.style.display = !q || name.includes(q) ? "" : "none";
      });
  });

  const tabs = document.querySelectorAll<HTMLButtonElement>(".tab");
  const panels = document.querySelectorAll<HTMLElement>("[data-panel]");
  tabs.forEach((tab) => {
    tab.addEventListener("click", () => {
      const target = tab.dataset.tab;
      tabs.forEach((t) => {
        const active = t === tab;
        t.classList.toggle("is-active", active);
        t.setAttribute("aria-selected", String(active));
      });
      panels.forEach((panel) => {
        panel.hidden = panel.dataset.panel !== target;
      });
    });
  });
</script>
